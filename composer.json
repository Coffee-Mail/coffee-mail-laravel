{
  "name": "coffeemail/coffeemail-laravel",
  "description": "Driver oficial do CoffeeMail para Laravel Mailer, notificações e webhooks, com integração Symfony Mailer e suporte nativo a filas assíncronas.",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "CoffeeMail Team",
      "email": "contato@coffeemail.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "coffeemail/coffeemail-php": "*",
    "illuminate/mail": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "symfony/mailer": "^6.2 || ^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "pestphp/pest": "^2.34 || ^3.0",
    "phpstan/phpstan": "^1.10 || ^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../coffee-mail-sdk-php",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "CoffeeMail\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoffeeMail\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CoffeeMail\\Laravel\\CoffeeMailServiceProvider"
      ],
      "aliases": {
        "CoffeeMail": "CoffeeMail\\Laravel\\Facades\\CoffeeMail"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=512M",
    "lint": "phpcs",
    "format": "phpcbf",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
